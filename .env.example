# =============================================================================
# ALESQUI INTELLIGENCE - BACKEND CONFIGURATION
# =============================================================================
# Copy this file to .env and configure your values before running the backend.
# Required variables are marked with [REQUIRED].
# =============================================================================

# =============================================================================
# MONGODB CONFIGURATION [REQUIRED]
# =============================================================================
# Full connection URI (recommended for local development and Atlas)
# Examples:
#   Local:  mongodb://localhost:27017
#   Atlas:  mongodb+srv://user:password@cluster.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# Database name
MONGODB_DATABASE=alesqui_intelligence

# Optional: separate credentials (only if not included in URI)
# MONGODB_USER=admin
# MONGODB_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
# MONGODB_AUTH_DB=admin

# =============================================================================
# SECURITY - JWT TOKENS [REQUIRED]
# =============================================================================
# Secret key for signing JWT tokens
# IMPORTANT: Must be at least 256 bits (32 characters)
# Generate using: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECURE_KEY_AT_LEAST_32_CHARS

# JWT token expiration time in milliseconds
# Default: 900000 (15 minutes)
JWT_EXPIRATION=900000

# JWT refresh token expiration time in milliseconds
# Default: 604800000 (7 days)
JWT_REFRESH_EXPIRATION=604800000

# =============================================================================
# AI CONFIGURATION [REQUIRED]
# =============================================================================
# AI Provider: openai (default) or ollama (self-hosted)
AI_PROVIDER=openai

# OpenAI (when AI_PROVIDER=openai)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Ollama (when AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4

# ReAct loop safety cap (optional, default 15)
# AI_REACT_MAX_ITERATIONS=15

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Deployment mode: CORPORATE (admin-managed users) or TRIAL (self-registration)
DEPLOYMENT_MODE=CORPORATE

# Company or organization name shown in the UI and emails
COMPANY_NAME="My Company Inc."

# Frontend URL used for CORS and email links
FRONTEND_URL=http://localhost:3000

# Base URL of this backend, shown in startup logs (CORPORATE mode)
APP_URL=http://localhost:8080

# Additional CORS allowed origins (comma-separated, optional)
# Example: https://app.example.com,https://test.example.com
CORS_ADDITIONAL_ORIGINS=

# Spring profile: use 'dev' for local development (enables localhost CORS, verbose logging)
SPRING_PROFILES_ACTIVE=dev

# Server port
PORT=8080

# =============================================================================
# INITIAL ADMIN USER (CORPORATE mode)
# =============================================================================
# On first startup, if no users exist, an admin account is created automatically.
#
# Customize the admin email (optional, defaults to admin@company.com):
# INITIAL_ADMIN_EMAIL=admin@mycompany.com
#
# Set a password (optional, leave commented to auto-generate):
# INITIAL_ADMIN_PASSWORD=
#
# If password is not set, a secure random password will be generated.
# Check the logs to see it:
#   mvn spring-boot:run | grep InitialAdmin

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
# SMTP server hostname
# Examples:
#   - Gmail:      smtp.gmail.com
#   - SendGrid:   smtp.sendgrid.net
#   - Mailgun:    smtp.mailgun.org
#   - Office 365: smtp.office365.com
SMTP_HOST=smtp.gmail.com

# SMTP server port
# Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=your-email@example.com

# SMTP authentication password
# Use an app-specific password for Gmail; API key for SendGrid/Mailgun
SMTP_PASSWORD=your-smtp-password

# Email address to send from (must be authorized by your SMTP provider)
MAIL_FROM_EMAIL=noreply@example.com

# Display name for sender
MAIL_FROM_NAME="Alesqui Intelligence"

# =============================================================================
# CHAT & AI (Optional)
# =============================================================================
# AI processing timeout in seconds (default: 120)
# chat.processing-timeout=120

# Maximum messages retained per conversation (default: 20)
# chat.max-conversation-history=20

# =============================================================================
# TRIAL MODE (only relevant when DEPLOYMENT_MODE=TRIAL)
# =============================================================================
# Trial account validity in days (default: 14)
# TRIAL_DURATION_DAYS=14

# Max trial registrations per IP per time window (default: 1)
# TRIAL_RATE_LIMIT_MAX_ATTEMPTS=1

# Rate limit window in hours (default: 24)
# TRIAL_RATE_LIMIT_WINDOW_HOURS=24

# =============================================================================
# AUDIT & LOGGING
# =============================================================================
# Number of days to retain audit logs (default: 730 / 2 years)
AUDIT_RETENTION_DAYS=730

# =============================================================================
# HTTP PROXY (Optional)
# =============================================================================
# Leave PROXY_HOST empty to disable proxy
# PROXY_HOST=
# PROXY_PORT=0

# =============================================================================
# LOGGING CONFIGURATION (Optional)
# =============================================================================
# Root logging level: DEBUG, INFO, WARN, ERROR (default: WARN)
# LOGGING_LEVEL_ROOT=WARN
#
# Application logging level: DEBUG, INFO, WARN, ERROR (default: INFO)
# LOGGING_LEVEL_ES_ALESQUI=INFO
